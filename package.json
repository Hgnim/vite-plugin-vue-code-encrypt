{
  "name": "vite-plugin-vue-code-encrypt",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/external/vite-plugin-vue-code-encrypt.umd.cjs",
  "module": "./dist/external/vite-plugin-vue-code-encrypt.es.js",
  "types": "./dist/external/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/external/index.d.ts",
      "import": "./dist/external/vite-plugin-vue-code-encrypt.es.js",
      "require": "./dist/external/vite-plugin-vue-code-encrypt.umd.cjs"
    },
    "./bundle": {
      "types": "./dist/bundle/index.d.ts",
      "import": "./dist/bundle/vite-plugin-vue-code-encrypt.es.js",
      "require": "./dist/bundle/vite-plugin-vue-code-encrypt.umd.cjs"
    }
  },
  "scripts": {
    "build": "npm run build:external && npm run build:bundle",
    "build:external": "vite build",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hgnim/vite-plugin-vue-code-encrypt.git"
  },
  "keywords": [],
  "author": "Hgnim",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/Hgnim/vite-plugin-vue-code-encrypt/issues"
  },
  "homepage": "https://github.com/Hgnim/vite-plugin-vue-code-encrypt#readme",
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2"
  },
  "dependencies": {
    "ez-encrypt": "github:Hgnim/ez-encrypt"
  }
}
